{
  "id": "eksempel-detail",
  "name": "EKSEMPEL – Detail (fiktiv)",
  "kind": "agreement",
  "version": 1,
  "valid_from": "2026-01-01",
  "valid_to": null,
  "inherits_from": "basis-dk",
  "source": "FIKTIV eksempel – ingen rigtig overenskomst",
  "example": true,
  "description": "Viser hvordan en detailoverenskomst kan udtrykkes med primitiverne. Alle satser, tider og regler er opdigtede og må aldrig bruges til løn.",
  "pay_codes": {
    "NORMAL": {
      "label": "Timeløn"
    },
    "OT50": {
      "label": "Overarbejde, de første 3 timer"
    },
    "OT100": {
      "label": "Overarbejde, derefter"
    },
    "AFTEN": {
      "label": "Aftentillæg"
    },
    "LOERDAG": {
      "label": "Lørdagstillæg"
    },
    "NAT": {
      "label": "Nattillæg"
    },
    "SOEN_HELLIG": {
      "label": "Søn- og helligdagstillæg"
    },
    "GARANTI": {
      "label": "Garantibetaling (min. vagt)"
    },
    "RAADIGHED": {
      "label": "Rådighed"
    },
    "TILKALD_GARANTI": {
      "label": "Minimumsbetaling ved tilkald"
    },
    "SYG": {
      "label": "Sygdom med løn"
    },
    "BARN_SYG": {
      "label": "Barns sygedag"
    },
    "OMSORG": {
      "label": "Omsorgsdag"
    }
  },
  "rules": [
    {
      "id": "loensats",
      "primitive": "pay_rate",
      "label": "Grundløn",
      "source": "Eksempel § 1",
      "todo_jura": "Fiktiv sats – udfyld fra overenskomstteksten.",
      "params": {
        "pay_code": "NORMAL",
        "rates": [
          {
            "hourly_ore": 15000
          },
          {
            "max_age": 18,
            "hourly_ore": 10000
          }
        ]
      }
    },
    {
      "id": "norm",
      "primitive": "norm",
      "label": "Normtid",
      "source": "Eksempel § 2",
      "todo_jura": "Fiktiv – normperiode og deltidsgrænser fra overenskomsten.",
      "params": {
        "period": {
          "type": "week"
        }
      }
    },
    {
      "id": "overarbejde",
      "primitive": "overtime",
      "label": "Overarbejde ud over ugenormen",
      "source": "Eksempel § 3",
      "todo_jura": "Fiktive trin og procenter.",
      "params": {
        "trigger": "weekly_norm",
        "tiers": [
          {
            "up_to_minutes": 180,
            "amount": {
              "type": "percent_of_base",
              "bp": 5000
            },
            "pay_code": "OT50"
          },
          {
            "up_to_minutes": null,
            "amount": {
              "type": "percent_of_base",
              "bp": 10000
            },
            "pay_code": "OT100"
          }
        ]
      }
    },
    {
      "id": "aftentillaeg",
      "primitive": "time_window_supplement",
      "label": "Aftentillæg hverdage 18–24",
      "source": "Eksempel § 4",
      "todo_jura": "Fiktivt tidsrum og beløb.",
      "stacking": {
        "mode": "highest",
        "group": "tidstillaeg"
      },
      "params": {
        "windows": [
          {
            "days": ["weekday"],
            "from": "18:00",
            "to": "24:00"
          }
        ],
        "amount": {
          "type": "ore_per_hour",
          "ore": 3000
        },
        "pay_code": "AFTEN"
      }
    },
    {
      "id": "loerdagstillaeg",
      "primitive": "time_window_supplement",
      "label": "Lørdagstillæg efter kl. 15",
      "source": "Eksempel § 4",
      "todo_jura": "Fiktivt tidsrum og beløb.",
      "stacking": {
        "mode": "highest",
        "group": "tidstillaeg"
      },
      "params": {
        "windows": [
          {
            "days": ["sat"],
            "from": "15:00",
            "to": "24:00"
          }
        ],
        "amount": {
          "type": "ore_per_hour",
          "ore": 4000
        },
        "pay_code": "LOERDAG"
      }
    },
    {
      "id": "nattillaeg",
      "primitive": "time_window_supplement",
      "label": "Nattillæg 00–06",
      "source": "Eksempel § 4",
      "todo_jura": "Fiktivt tidsrum og beløb.",
      "stacking": {
        "mode": "highest",
        "group": "tidstillaeg"
      },
      "params": {
        "windows": [
          {
            "days": ["any"],
            "from": "00:00",
            "to": "06:00"
          }
        ],
        "exclude_holidays": false,
        "amount": {
          "type": "ore_per_hour",
          "ore": 4500
        },
        "pay_code": "NAT"
      }
    },
    {
      "id": "soen-og-helligdag",
      "primitive": "time_window_supplement",
      "label": "Søn- og helligdagstillæg",
      "source": "Eksempel § 5",
      "todo_jura": "Fiktiv procent.",
      "stacking": {
        "mode": "highest",
        "group": "tidstillaeg"
      },
      "params": {
        "windows": [
          {
            "days": ["sun", "holiday"],
            "from": "00:00",
            "to": "24:00"
          }
        ],
        "exclude_holidays": false,
        "amount": {
          "type": "percent_of_base",
          "bp": 10000
        },
        "pay_code": "SOEN_HELLIG"
      }
    },
    {
      "id": "helligdage",
      "label": "Helligdage + særdage",
      "source": "Eksempel § 5 (særdage)",
      "todo_jura": "Fiktive særdage.",
      "params": {
        "holidays": [
          "nytaarsdag",
          "skaertorsdag",
          "langfredag",
          "paaskedag",
          "anden_paaskedag",
          "kristi_himmelfartsdag",
          "pinsedag",
          "anden_pinsedag",
          "juledag",
          "anden_juledag",
          "grundlovsdag",
          "juleaftensdag",
          "nytaarsaftensdag"
        ],
        "partial": [
          {
            "key": "grundlovsdag",
            "from": "12:00"
          }
        ]
      }
    },
    {
      "id": "pause",
      "source": "Eksempel § 6",
      "todo_jura": "Fiktiv pauselængde.",
      "params": {
        "min_minutes": 30,
        "paid": false
      }
    },
    {
      "id": "afrunding",
      "primitive": "rounding",
      "label": "Afrunding til kvarter",
      "source": "Eksempel § 7",
      "todo_jura": "Fiktiv afrunding og tolerance.",
      "params": {
        "unit_minutes": 15,
        "start": "nearest",
        "end": "nearest",
        "snap_before_start_minutes": 10,
        "snap_after_end_minutes": 10
      }
    },
    {
      "id": "min-vagt",
      "primitive": "min_shift",
      "label": "Mindst 3 timer pr. fremmøde",
      "source": "Eksempel § 8",
      "todo_jura": "Fiktiv minimumsvagt.",
      "params": {
        "min_minutes": 180,
        "guarantee_pay": true,
        "pay_code": "GARANTI"
      }
    },
    {
      "id": "raadighed",
      "primitive": "on_call",
      "label": "Rådighed og tilkald",
      "source": "Eksempel § 9",
      "todo_jura": "Fiktive satser.",
      "params": {
        "amount": {
          "type": "ore_per_hour",
          "ore": 2000
        },
        "pay_code": "RAADIGHED",
        "call_out_min_minutes": 180,
        "call_out_guarantee_pay_code": "TILKALD_GARANTI"
      }
    },
    {
      "id": "natarbejde",
      "primitive": "night_work",
      "label": "Natarbejde",
      "source": "Eksempel § 10",
      "todo_jura": "Fiktiv definition af nattetid.",
      "params": {
        "from": "23:00",
        "to": "06:00",
        "night_shift_min_minutes": 180,
        "max_average_daily_minutes": 480,
        "reference_days": 7
      }
    },
    {
      "id": "fravaer",
      "primitive": "absence",
      "label": "Fravær",
      "source": "Eksempel § 11",
      "todo_jura": "Fiktive fraværstyper og betaling.",
      "params": {
        "types": [
          {
            "code": "sick",
            "label": "Sygdom",
            "payment": "full",
            "pay_code": "SYG",
            "counts_towards_norm": true
          },
          {
            "code": "child_sick",
            "label": "Barns første sygedag",
            "payment": "full",
            "pay_code": "BARN_SYG",
            "counts_towards_norm": true
          },
          {
            "code": "care_day",
            "label": "Omsorgsdag",
            "payment": "full",
            "pay_code": "OMSORG",
            "counts_towards_norm": true,
            "entitlement": {
              "days": 2,
              "period": "calendar_year",
              "accrual": "upfront"
            }
          },
          {
            "code": "unpaid_leave",
            "label": "Tjenestefri uden løn",
            "payment": "none",
            "pay_code": null,
            "counts_towards_norm": false
          }
        ]
      }
    },
    {
      "id": "ferie",
      "source": "Eksempel § 12 (feriefridage)",
      "todo_jura": "Fiktivt antal feriefridage.",
      "params": {
        "extra_days": {
          "days_per_year": 5,
          "year_start": "05-01",
          "accrual": "upfront"
        }
      }
    },
    {
      "id": "varsling",
      "primitive": "notice",
      "label": "Varsling af vagtplan",
      "source": "Eksempel § 13",
      "todo_jura": "Fiktivt varsel.",
      "params": {
        "publish_notice_days": 14,
        "change_notice_hours": 96
      }
    },
    {
      "id": "weekendfri",
      "primitive": "weekend_off",
      "label": "Fri weekender",
      "source": "Eksempel § 14",
      "todo_jura": "Fiktivt antal fri weekender.",
      "params": {
        "weekends_off": 2,
        "per_weeks": 4
      }
    }
  ]
}
