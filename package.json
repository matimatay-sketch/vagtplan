{
  "name": "vagtplan",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,storage-api",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > apps/web/src/lib/supabase/database.types.ts",
    "e2e": "pnpm --filter web e2e"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "3.1.0",
    "typescript": "^5.9.3"
  }
}
