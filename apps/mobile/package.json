{
  "name": "@vagtplan/mobile",
  "private": true,
  "description": "Turnus som app i App Store og Google Play (Capacitor). Appen viser Turnus fra serveren og tilføjer push-notifikationer.",
  "scripts": {
    "sync": "node scripts/write-www.mjs && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "assets": "capacitor-assets generate --assetPath assets --iconBackgroundColor '#16212e' --iconBackgroundColorDark '#16212e' --splashBackgroundColor '#f2f5f4' --splashBackgroundColorDark '#0f1a22'"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
